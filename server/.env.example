# ── ragkit server configuration ────────────────────────────────────────
# Copy this file to .env and adjust values as needed.

# Server
RAGKIT_PORT=8080
RAGKIT_CORS_ORIGINS=*
RAGKIT_DATA_DIR=/data

# LLM API Keys (can also be configured via the web UI)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
COHERE_API_KEY=
VOYAGE_API_KEY=

# Ollama (if running on the host or another container)
OLLAMA_BASE_URL=http://host.docker.internal:11434
